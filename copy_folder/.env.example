# Copy to .env for local development. Never commit .env.
# Every value here must stay EMPTY in this file (except safe defaults below).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Local only. Do NOT set this on Railway — Railway injects PORT at runtime.
PORT=3000

# ---------------------------------------------------------------------------
# BigQuery — required
# ---------------------------------------------------------------------------
# Full service-account JSON, flattened to a SINGLE line:
#   jq -c . service-account.json | pbcopy
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# GCP project that owns the dataset.
BQ_PROJECT_ID=

# Dataset / table your SQL reads.
BQ_DATASET=
BQ_TABLE=

# Job location — must match the dataset region EXACTLY.
# `US` (multi-region) and `us-central1` (single region) are different.
BQ_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Extract window / filters (wire these in src/queries.js → extractParams)
# ---------------------------------------------------------------------------
BQ_RANGE_START=2024-01-01

# ---------------------------------------------------------------------------
# Refresh schedule
# ---------------------------------------------------------------------------
# HH:MM 24h, or "off" to use CACHE_TTL_MS instead.
REFRESH_AT=10:00
REFRESH_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Cost + performance
# ---------------------------------------------------------------------------
CACHE_TTL_MS=21600000
CACHE_MANUAL_COOLDOWN_MS=60000
BQ_MAX_BYTES_BILLED=2147483648

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Set BOTH to enable HTTP Basic over page + API.
# Generate a password with:  openssl rand -base64 32
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional: x-api-token header for scripted access.
API_TOKEN=

# Set to "1" to expose /api/debug/*. Leave OFF in production.
ENABLE_DEBUG_ENDPOINTS=
