# Copy to .env for local development. Never commit .env.
# Every value here must stay EMPTY in this file (except safe defaults below).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Local only. Do NOT set this on Railway — Railway injects PORT at runtime.
PORT=3000

# Set to 1 to serve synthetic trial rows without BigQuery (local UI review).
# Leave empty / 0 in production.
DEMO_MODE=1

# ---------------------------------------------------------------------------
# BigQuery — required when DEMO_MODE is off
# ---------------------------------------------------------------------------
# Full service-account JSON, flattened to a SINGLE line:
#   jq -c . service-account.json | pbcopy
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# GCP project that owns the datasets.
BQ_PROJECT_ID=

# Job location — must match the dataset region EXACTLY.
BQ_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Table locations (defaults match the shared SQL; override if FQNs differ)
# ---------------------------------------------------------------------------
BQ_FUNNEL_DATASET=hubspot_migration
BQ_FUNNEL_TABLE=reporting_user_funnel_new_hs

BQ_FUM_DATASET=analytics_reporting
BQ_FUM_TABLE=fact_user_master

BQ_UPGRADE_DATASET=justcall
BQ_UPGRADE_TABLE=upgradeDowngradeLogs

# Former dbt ref('sfdc_user_role_hs') — confirm real dataset/table.
BQ_SFDC_DATASET=hubspot_migration
BQ_SFDC_TABLE=sfdc_user_role_hs

# Legacy single-table placeholders (unused by this multi-table extract).
BQ_DATASET=
BQ_TABLE=

# ---------------------------------------------------------------------------
# Trial limit defaults (Enterprise FUP — product doc)
# ---------------------------------------------------------------------------
# Enterprise trials default to this cap; Custom override → Unlimited.
ENTERPRISE_DEFAULT_USAGE_LIMIT=2000
STANDARD_DEFAULT_USAGE_LIMIT=500

# ---------------------------------------------------------------------------
# Extract window / plan-override IDs
# ---------------------------------------------------------------------------
BQ_RANGE_START=2026-01-01
BQ_PREVIOUS_PLAN_ID=1194
BQ_CHANGED_TO_PLAN_ID=100

# ---------------------------------------------------------------------------
# Refresh schedule
# ---------------------------------------------------------------------------
REFRESH_AT=10:00
REFRESH_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Cost + performance
# ---------------------------------------------------------------------------
CACHE_TTL_MS=21600000
CACHE_MANUAL_COOLDOWN_MS=60000
BQ_MAX_BYTES_BILLED=2147483648

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
DASHBOARD_USER=
DASHBOARD_PASSWORD=

API_TOKEN=

ENABLE_DEBUG_ENDPOINTS=
