# Copy to .env for local development. Never commit .env.
# Every value here must stay EMPTY in this file (except safe defaults below).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Local only. Do NOT set this on Railway — Railway injects PORT at runtime.
PORT=3000

# Set to 1 to serve synthetic tracker rows without BigQuery (local UI review).
# Leave empty / 0 in production.
DEMO_MODE=1

# ---------------------------------------------------------------------------
# BigQuery — required when DEMO_MODE is off
# ---------------------------------------------------------------------------
# Full service-account JSON, flattened to a SINGLE line:
#   jq -c . service-account.json | pbcopy
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# GCP project that owns the datasets.
BQ_PROJECT_ID=

# Job location — must match the dataset region EXACTLY.
BQ_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Table locations (defaults match the tracker SQL; override if FQNs differ)
# ---------------------------------------------------------------------------
BQ_FUM_DATASET=analytics_reporting
BQ_FUM_TABLE=fact_user_master

BQ_JC_USERS_DATASET=analytics_intermediate
BQ_JC_USERS_TABLE=justcall_users

BQ_INTERNAL_EMAILS_DATASET=analytics_intermediate
BQ_INTERNAL_EMAILS_TABLE=int_internal_emails

BQ_INT_LOGS_DATASET=justcall
BQ_INT_LOGS_TABLE=int_logs_status

BQ_INT_CONNECT_DATASET=justcall
BQ_INT_CONNECT_TABLE=int_connect_jclive

BQ_SF_INFO_DATASET=jclive
BQ_SF_INFO_TABLE=salesforce_info

# ---------------------------------------------------------------------------
# Refresh schedule
# ---------------------------------------------------------------------------
REFRESH_AT=10:00
REFRESH_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Cost + performance
# ---------------------------------------------------------------------------
CACHE_TTL_MS=21600000
CACHE_MANUAL_COOLDOWN_MS=60000
# This extract scans history from Nov 2024, including a 1-day time-travel read
# of salesforce_info. 50 GiB ceiling; raise it if the job is rejected for bytes.
BQ_MAX_BYTES_BILLED=53687091200

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
DASHBOARD_USER=
DASHBOARD_PASSWORD=

API_TOKEN=

ENABLE_DEBUG_ENDPOINTS=
